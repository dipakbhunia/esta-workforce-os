# PostgreSQL
POSTGRES_DB=esta_workforce
POSTGRES_USER=esta
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://esta:change_me@localhost:5432/esta_workforce?schema=public

# Backend
PORT=3000
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=
PAYMENT_CREDENTIAL_ENCRYPTION_KEY_VERSION=

# Development seed accounts
SEED_SUPER_ADMIN_EMAIL=superadmin@esta.local
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_COMPANY_ADMIN_EMAIL=admin@demo.esta.local
SEED_COMPANY_ADMIN_PASSWORD=CompanyAdmin@123

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ROOT_USER=esta_minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_SCREENSHOTS_BUCKET=esta-screenshots

# Monitoring alert detection thresholds
ALERT_DEVICE_OFFLINE_MINUTES=10
ALERT_MISSING_HEARTBEAT_MINUTES=20
ALERT_EXCESSIVE_IDLE_MINUTES=30
ALERT_SCREENSHOT_MISSING_MINUTES=30
ALERT_EVALUATION_INTERVAL_MINUTES=5
ALERT_EVALUATION_ENABLED=true

# Notification delivery (Phase 7C)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Esta Workforce OS
