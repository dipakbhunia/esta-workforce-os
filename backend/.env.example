# The backend loads environment variables from the repository root .env file.
DATABASE_URL=postgresql://esta:change_me@localhost:5432/esta_workforce?schema=public
PORT=3000

# Use independent secrets with at least 32 characters.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PUBLIC_APP_ORIGIN=http://localhost:5173
# Optional dedicated HMAC secret (32+ characters); JWT_REFRESH_SECRET is the compatibility fallback.
IDENTITY_ACTION_TOKEN_SECRET=
IDENTITY_INVITATION_TTL_HOURS=48
IDENTITY_PASSWORD_RESET_TTL_MINUTES=30
IDENTITY_RECOVERY_EMAIL_LIMIT_PER_HOUR=5
IDENTITY_RECOVERY_IP_LIMIT_PER_HOUR=20

# Development seed accounts. Change these outside local development.
SEED_SUPER_ADMIN_EMAIL=superadmin@esta.local
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@123
SEED_COMPANY_ADMIN_EMAIL=admin@demo.esta.local
SEED_COMPANY_ADMIN_PASSWORD=CompanyAdmin@123
