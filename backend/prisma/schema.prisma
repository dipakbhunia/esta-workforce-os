generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  TRIAL
  SUSPENDED
}

enum RoleName {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  AUTO_PUNCHED_OUT
}

enum AttendanceLogType {
  PUNCH_IN
  PUNCH_OUT
}

enum AttendanceCloseSource {
  EMPLOYEE
  ADMIN
  SYSTEM
  CORRECTION
}

enum AttendanceCloseReason {
  NORMAL_PUNCH_OUT
  HEARTBEAT_TIMEOUT
  MISSED_PUNCH_OUT
  MAX_SESSION_EXCEEDED
  DEVICE_OFFLINE
  SYSTEM_SHUTDOWN_UNCONFIRMED
  ADMIN_CORRECTION
  BREAK_DURATION_EXCEEDED
  PREVIOUS_DAY_AUTO_CLOSE
}

enum AttendanceCorrectionType {
  MISSED_PUNCH_IN
  MISSED_PUNCH_OUT
  TIME_CORRECTION
  FULL_DAY_REGULARIZATION
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum MonitoringDeviceStatus {
  ACTIVE
  INACTIVE
  TRUSTED
  REVOKED
  REREGISTRATION_REQUIRED
}

enum MonitoringAlertType {
  DEVICE_OFFLINE
  MISSING_HEARTBEAT
  MONITORING_DISABLED
  DEVICE_REVOKED
  REREGISTRATION_REQUIRED
  EXCESSIVE_IDLE
  SCREENSHOT_MISSING
}

enum MonitoringAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MonitoringAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum MonitoringAlertEventType {
  DETECTED
  REDETECTED
  ACKNOWLEDGED
  RESOLVED
  AUTO_RESOLVED
  REOPENED
}

enum MonitoringAlertPolicyScope {
  SYSTEM
  COMPANY
  BRANCH
  DEPARTMENT
  EMPLOYEE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationType {
  ALERT_OPENED
  ALERT_REOPENED
  ALERT_ACKNOWLEDGED
  ALERT_RESOLVED
  ALERT_AUTO_RESOLVED
}

enum ProductivityCategory {
  PRODUCTIVE
  NEUTRAL
  UNPRODUCTIVE
  UNCLASSIFIED
}

enum ShiftAssignmentStatus {
  ACTIVE
  SCHEDULED
  ENDED
  CANCELLED
}

enum ShiftAssignmentType {
  PERMANENT
  TEMPORARY
  ROTATIONAL
  MANUAL_OVERRIDE
}

enum AssignmentSource {
  EMPLOYEE_PROFILE
  SHIFT_ASSIGNMENT
  ROSTER
  SYSTEM
  IMPORT
}

enum ShiftRosterStatus {
  DRAFT
  PUBLISHED
  LOCKED
  CANCELLED
}

enum RosterDayType {
  WORKING
  WEEKLY_OFF
  HOLIDAY
  LEAVE
  NO_SHIFT
}

enum RosterDaySource {
  MANUAL
  SHIFT_ASSIGNMENT
  TEMPLATE
  ROTATION
  WEEKLY_OFF_RULE
  HOLIDAY_CALENDAR
  SYSTEM
  IMPORT
  MANUAL_OVERRIDE
}

enum WeeklyOffRuleType {
  FIXED_WEEKDAYS
}

enum HolidayType {
  NATIONAL
  REGIONAL
  COMPANY
  OPTIONAL
  CUSTOM
}

model Company {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  slug               String
  status             CompanyStatus      @default(TRIAL)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  branches           Branch[]
  departments        Department[]
  designations       Designation[]
  shifts             Shift[]
  users              User[]
  employees          Employee[]
  shiftAssignments   EmployeeShiftAssignment[]
  shiftRosterPeriods ShiftRosterPeriod[]
  shiftRosterDays    ShiftRosterDay[]
  rosterTemplates    RosterTemplate[]
  rosterTemplateDays RosterTemplateDay[]
  weeklyOffRules     WeeklyOffRule[]
  holidayCalendars   HolidayCalendar[]
  holidays           Holiday[]
  attendances        Attendance[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  leaveTypes         LeaveType[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  leaveApprovalHistories LeaveApprovalHistory[]
  breakPolicies      BreakPolicy[]
  attendancePolicies AttendancePolicy[]
  monitoringDevices  MonitoringDevice[]
  heartbeats         Heartbeat[]
  activitySessions   ActivitySession[]
  screenshots        Screenshot[]
  applicationUsages  ApplicationUsage[]
  websiteUsages      WebsiteUsage[]
    monitoringAlerts   MonitoringAlert[]
  monitoringAlertEvents MonitoringAlertEvent[]
    monitoringAlertPolicies MonitoringAlertPolicy[]
  notifications      Notification[]
  notificationPreferences NotificationPreference[]
  applicationProductivityRules ApplicationProductivityRule[]
  websiteProductivityRules WebsiteProductivityRule[]
  roles              Role[]
  auditLogs          AuditLog[]

  @@index([status])
  @@index([slug])
  @@index([deletedAt])
}

model Branch {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  name        String
  code        String
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments Department[]
  users       User[]
  employees   Employee[]
  shiftRosterPeriods ShiftRosterPeriod[]
  rosterTemplates RosterTemplate[]
  weeklyOffRules WeeklyOffRule[]
  holidayCalendars HolidayCalendar[]

    monitoringAlertPolicies MonitoringAlertPolicy[]

  @@index([companyId])
  @@index([companyId, code])
  @@index([deletedAt])
}

model Department {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @db.Uuid
  branchId     String?       @db.Uuid
  name         String
  code         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  designations Designation[]
  users        User[]
  employees    Employee[]
  shiftRosterPeriods ShiftRosterPeriod[]
  rosterTemplates RosterTemplate[]
  weeklyOffRules WeeklyOffRule[]

    monitoringAlertPolicies MonitoringAlertPolicy[]

  @@index([companyId])
  @@index([companyId, code])
  @@index([branchId])
  @@index([deletedAt])
}

model Designation {
  id           String      @id @default(uuid()) @db.Uuid
  companyId    String      @db.Uuid
  departmentId String?     @db.Uuid
  name         String
  code         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users        User[]
  employees    Employee[]

  @@index([companyId])
  @@index([companyId, code])
  @@index([departmentId])
  @@index([deletedAt])
}

model Shift {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @db.Uuid
  name      String
  code      String
  startTime String
  endTime   String
  timezone  String     @default("UTC")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users     User[]
  employees Employee[]
  shiftAssignments EmployeeShiftAssignment[]
  attendanceSnapshots Attendance[] @relation("AttendanceShiftSnapshot")
  rosterDays ShiftRosterDay[]
  rosterTemplateDays RosterTemplateDay[]

  @@index([companyId])
  @@index([companyId, code])
  @@index([deletedAt])
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String?        @db.Uuid
  branchId      String?        @db.Uuid
  departmentId  String?        @db.Uuid
  designationId String?        @db.Uuid
  shiftId       String?        @db.Uuid
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  status        UserStatus     @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation   Designation?   @relation(fields: [designationId], references: [id], onDelete: SetNull)
  shift         Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("AuditLogActor")
  createdShiftAssignments EmployeeShiftAssignment[] @relation("ShiftAssignmentCreator")
  updatedShiftAssignments EmployeeShiftAssignment[] @relation("ShiftAssignmentUpdater")
  publishedShiftRosterPeriods ShiftRosterPeriod[] @relation("ShiftRosterPublishedBy")
  lockedShiftRosterPeriods ShiftRosterPeriod[] @relation("ShiftRosterLockedBy")
  createdShiftRosterPeriods ShiftRosterPeriod[] @relation("ShiftRosterCreatedBy")
  updatedShiftRosterPeriods ShiftRosterPeriod[] @relation("ShiftRosterUpdatedBy")
  createdShiftRosterDays ShiftRosterDay[] @relation("ShiftRosterDayCreatedBy")
  updatedShiftRosterDays ShiftRosterDay[] @relation("ShiftRosterDayUpdatedBy")
  createdRosterTemplates RosterTemplate[] @relation("RosterTemplateCreatedBy")
  updatedRosterTemplates RosterTemplate[] @relation("RosterTemplateUpdatedBy")
  createdRosterTemplateDays RosterTemplateDay[] @relation("RosterTemplateDayCreatedBy")
  updatedRosterTemplateDays RosterTemplateDay[] @relation("RosterTemplateDayUpdatedBy")
  createdWeeklyOffRules WeeklyOffRule[] @relation("WeeklyOffRuleCreatedBy")
  updatedWeeklyOffRules WeeklyOffRule[] @relation("WeeklyOffRuleUpdatedBy")
  createdHolidayCalendars HolidayCalendar[] @relation("HolidayCalendarCreatedBy")
  updatedHolidayCalendars HolidayCalendar[] @relation("HolidayCalendarUpdatedBy")
  createdHolidays Holiday[] @relation("HolidayCreatedBy")
  updatedHolidays Holiday[] @relation("HolidayUpdatedBy")
  employee      Employee?
  requestedAttendanceCorrections AttendanceCorrectionRequest[] @relation("AttendanceCorrectionRequester")
  reviewedAttendanceCorrections  AttendanceCorrectionRequest[] @relation("AttendanceCorrectionReviewer")
  leaveApprovalHistories         LeaveApprovalHistory[]        @relation("LeaveApprovalHistoryActor")

    acknowledgedMonitoringAlerts   MonitoringAlert[]            @relation("MonitoringAlertAcknowledgedBy")
  resolvedMonitoringAlerts       MonitoringAlert[]            @relation("MonitoringAlertResolvedBy")
  monitoringAlertEvents          MonitoringAlertEvent[]       @relation("MonitoringAlertEventActor")
  notifications                  Notification[]
  notificationPreference         NotificationPreference?

  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
}

model Employee {
  id                           String             @id @default(uuid()) @db.Uuid
  userId                       String             @unique @db.Uuid
  companyId                    String             @db.Uuid
  branchId                     String?            @db.Uuid
  departmentId                 String?            @db.Uuid
  designationId                String?            @db.Uuid
  shiftId                      String?            @db.Uuid
  reportingManagerId           String?            @db.Uuid
  employeeCode                 String
  joiningDate                  DateTime           @db.Date
  employmentType               EmploymentType
  workMode                     WorkMode
  status                       EmployeeStatus     @default(ACTIVE)
  phone                        String?
  alternatePhone               String?
  personalEmail                String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  state                        String?
  postalCode                   String?
  country                      String?
  documents                    Json?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  deletedAt                    DateTime?
  user                         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  company                      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department                   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation                  Designation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  shift                        Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  reportingManager             Employee?          @relation("EmployeeReporting", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports                Employee[]         @relation("EmployeeReporting")
  shiftAssignments             EmployeeShiftAssignment[]
  rosterDays                   ShiftRosterDay[]
  weeklyOffRules               WeeklyOffRule[]
  attendances                  Attendance[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  leaveRequests                LeaveRequest[]     @relation("LeaveRequestEmployee")
  approvedLeaveRequests        LeaveRequest[]     @relation("LeaveRequestApprover")
  leaveBalances                LeaveBalance[]
  monitoringDevices            MonitoringDevice[]
  heartbeats                   Heartbeat[]
  activitySessions             ActivitySession[]
  screenshots                  Screenshot[]
  applicationUsages            ApplicationUsage[]
  websiteUsages                WebsiteUsage[]

    monitoringAlerts             MonitoringAlert[]

    monitoringAlertPolicies             MonitoringAlertPolicy[]

  @@index([companyId])
  @@index([companyId, employeeCode])
  @@index([branchId])
  @@index([departmentId])
  @@index([designationId])
  @@index([shiftId])
  @@index([reportingManagerId])
  @@index([status])
  @@index([deletedAt])
}

model ShiftRosterPeriod {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @db.Uuid
  branchId      String?           @db.Uuid
  departmentId  String?           @db.Uuid
  name          String
  code          String
  dateFrom      DateTime          @db.Date
  dateTo        DateTime          @db.Date
  timezone      String            @default("UTC")
  status        ShiftRosterStatus @default(DRAFT)
  version       Int               @default(1)
  publishedAt   DateTime?
  publishedById String?           @db.Uuid
  lockedAt      DateTime?
  lockedById    String?           @db.Uuid
  notes         String?
  createdById   String?           @db.Uuid
  updatedById   String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  publishedBy   User?             @relation("ShiftRosterPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  lockedBy      User?             @relation("ShiftRosterLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("ShiftRosterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?             @relation("ShiftRosterUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  days          ShiftRosterDay[]
  attendances   Attendance[]      @relation("AttendanceRosterPeriodSnapshot")

  @@index([companyId, dateFrom, dateTo])
  @@index([companyId, status])
  @@index([branchId, dateFrom, dateTo])
  @@index([departmentId, dateFrom, dateTo])
  @@index([deletedAt])
}

model ShiftRosterDay {
  id                String          @id @default(uuid()) @db.Uuid
  companyId         String          @db.Uuid
  rosterPeriodId    String          @db.Uuid
  employeeId        String          @db.Uuid
  workDate          DateTime        @db.Date
  dayType           RosterDayType
  shiftId           String?         @db.Uuid
  source            RosterDaySource @default(MANUAL)
  shiftName         String?
  shiftCode         String?
  shiftStartTime    String?
  shiftEndTime      String?
  shiftTimezone     String?
  scheduledStartAt  DateTime?
  scheduledEndAt    DateTime?
  notes             String?
  createdById       String?         @db.Uuid
  updatedById       String?         @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rosterPeriod      ShiftRosterPeriod @relation(fields: [rosterPeriodId], references: [id], onDelete: Cascade)
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift             Shift?          @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdBy         User?           @relation("ShiftRosterDayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?           @relation("ShiftRosterDayUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attendances       Attendance[]    @relation("AttendanceRosterDaySnapshot")

  @@unique([companyId, employeeId, workDate, rosterPeriodId])
  @@index([companyId, workDate])
  @@index([employeeId, workDate])
  @@index([rosterPeriodId])
  @@index([shiftId])
  @@index([dayType])
  @@index([source])
  @@index([deletedAt])
}

model WeeklyOffRule {
  id                   String            @id @default(uuid()) @db.Uuid
  companyId            String            @db.Uuid
  branchId             String?           @db.Uuid
  departmentId         String?           @db.Uuid
  employeeId           String?           @db.Uuid
  name                 String
  timezone             String            @default("UTC")
  ruleType             WeeklyOffRuleType @default(FIXED_WEEKDAYS)
  weekdays             Json
  alternateWeekPattern Json?
  effectiveFrom        DateTime          @db.Date
  effectiveTo          DateTime?         @db.Date
  priority             Int               @default(100)
  enabled              Boolean           @default(true)
  createdById          String?           @db.Uuid
  updatedById          String?           @db.Uuid
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch               Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department           Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employee             Employee?         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy            User?             @relation("WeeklyOffRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?             @relation("WeeklyOffRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attendances          Attendance[]      @relation("AttendanceWeeklyOffSnapshot")

  @@index([companyId, enabled, priority])
  @@index([employeeId, effectiveFrom, effectiveTo])
  @@index([departmentId, effectiveFrom, effectiveTo])
  @@index([branchId, effectiveFrom, effectiveTo])
  @@index([deletedAt])
}

model HolidayCalendar {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  branchId    String?   @db.Uuid
  name        String
  year        Int?
  description String?
  notes       String?
  timezone    String    @default("UTC")
  enabled     Boolean   @default(true)
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("HolidayCalendarCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("HolidayCalendarUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  holidays    Holiday[]

  @@index([companyId, enabled])
  @@index([branchId, enabled])
  @@index([companyId, year])
  @@index([branchId, year])
  @@index([deletedAt])
}

model Holiday {
  id          String       @id @default(uuid()) @db.Uuid
  calendarId  String       @db.Uuid
  companyId   String       @db.Uuid
  date        DateTime     @db.Date
  name        String
  type        HolidayType  @default(COMPANY)
  optional    Boolean      @default(false)
  recurring   Boolean      @default(false)
  notes       String?
  createdById String?      @db.Uuid
  updatedById String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  calendar    HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy   User?        @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("HolidayUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attendances Attendance[] @relation("AttendanceHolidaySnapshot")

  @@unique([calendarId, date, name])
  @@index([companyId, date])
  @@index([calendarId, date])
  @@index([deletedAt])
}
model RosterTemplate {
  id           String              @id @default(uuid()) @db.Uuid
  companyId    String              @db.Uuid
  branchId     String?             @db.Uuid
  departmentId String?             @db.Uuid
  name         String
  code         String
  description  String?
  timezone     String              @default("UTC")
  enabled      Boolean             @default(true)
  version      Int                 @default(1)
  notes        String?
  createdById  String?             @db.Uuid
  updatedById  String?             @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation("RosterTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?               @relation("RosterTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  days         RosterTemplateDay[]

  @@index([companyId, enabled])
  @@index([branchId, enabled])
  @@index([departmentId, enabled])
  @@index([deletedAt])
}

model RosterTemplateDay {
  id             String        @id @default(uuid()) @db.Uuid
  templateId     String        @db.Uuid
  companyId      String        @db.Uuid
  sequence       Int
  dayOfWeek      Int
  dayType        RosterDayType
  shiftId        String?       @db.Uuid
  shiftName      String?
  shiftCode      String?
  shiftStartTime String?
  shiftEndTime   String?
  shiftTimezone  String?
  notes          String?
  createdById    String?       @db.Uuid
  updatedById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  template       RosterTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  shift          Shift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("RosterTemplateDayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?         @relation("RosterTemplateDayUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, dayOfWeek])
  @@index([templateId, sequence])
  @@index([shiftId])
  @@index([dayType])
  @@index([deletedAt])
}
model EmployeeShiftAssignment {
  id             String                @id @default(uuid()) @db.Uuid
  companyId      String                @db.Uuid
  employeeId     String                @db.Uuid
  shiftId        String                @db.Uuid
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  status         ShiftAssignmentStatus @default(ACTIVE)
  assignmentType ShiftAssignmentType   @default(PERMANENT)
  source         AssignmentSource      @default(SHIFT_ASSIGNMENT)
  reason         String?
  notes          String?
  createdById    String?               @db.Uuid
  updatedById    String?               @db.Uuid
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee       Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift          Shift                 @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdBy      User?                 @relation("ShiftAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
