generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  TRIAL
  SUSPENDED
}

enum RoleName {
  SUPER_ADMIN
  COMPANY_ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  AUTO_PUNCHED_OUT
}

enum AttendanceLogType {
  PUNCH_IN
  PUNCH_OUT
}

enum AttendanceCloseSource {
  EMPLOYEE
  ADMIN
  SYSTEM
  CORRECTION
}

enum AttendanceCloseReason {
  NORMAL_PUNCH_OUT
  HEARTBEAT_TIMEOUT
  MISSED_PUNCH_OUT
  MAX_SESSION_EXCEEDED
  DEVICE_OFFLINE
  SYSTEM_SHUTDOWN_UNCONFIRMED
  ADMIN_CORRECTION
  BREAK_DURATION_EXCEEDED
  PREVIOUS_DAY_AUTO_CLOSE
}

enum AttendanceCorrectionType {
  MISSED_PUNCH_IN
  MISSED_PUNCH_OUT
  TIME_CORRECTION
  FULL_DAY_REGULARIZATION
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum MonitoringDeviceStatus {
  ACTIVE
  INACTIVE
  TRUSTED
  REVOKED
  REREGISTRATION_REQUIRED
}

enum MonitoringAlertType {
  DEVICE_OFFLINE
  MISSING_HEARTBEAT
  MONITORING_DISABLED
  DEVICE_REVOKED
  REREGISTRATION_REQUIRED
  EXCESSIVE_IDLE
  SCREENSHOT_MISSING
}

enum MonitoringAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MonitoringAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum MonitoringAlertEventType {
  DETECTED
  REDETECTED
  ACKNOWLEDGED
  RESOLVED
  AUTO_RESOLVED
  REOPENED
}

enum MonitoringAlertPolicyScope {
  SYSTEM
  COMPANY
  BRANCH
  DEPARTMENT
  EMPLOYEE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationType {
  ALERT_OPENED
  ALERT_REOPENED
  ALERT_ACKNOWLEDGED
  ALERT_RESOLVED
  ALERT_AUTO_RESOLVED
}

enum ProductivityCategory {
  PRODUCTIVE
  NEUTRAL
  UNPRODUCTIVE
  UNCLASSIFIED
}

enum ShiftAssignmentStatus {
  ACTIVE
  SCHEDULED
  ENDED
  CANCELLED
}

enum ShiftAssignmentType {
  PERMANENT
  TEMPORARY
  ROTATIONAL
  MANUAL_OVERRIDE
}

enum AssignmentSource {
  EMPLOYEE_PROFILE
  SHIFT_ASSIGNMENT
  ROSTER
  SYSTEM
  IMPORT
}

enum ShiftRosterStatus {
  DRAFT
  PUBLISHED
  LOCKED
  CANCELLED
}

enum RosterDayType {
  WORKING
  WEEKLY_OFF
  HOLIDAY
  LEAVE
  NO_SHIFT
}

enum RosterDaySource {
  MANUAL
  SHIFT_ASSIGNMENT
  TEMPLATE
  ROTATION
  WEEKLY_OFF_RULE
  HOLIDAY_CALENDAR
  SYSTEM
  IMPORT
  MANUAL_OVERRIDE
}

enum WeeklyOffRuleType {
  FIXED_WEEKDAYS
}

enum HolidayType {
  NATIONAL
  REGIONAL
  COMPANY
  OPTIONAL
  CUSTOM
}

enum PlanStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PlanBillingModel {
  PER_USER
  CUSTOM
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  SUPERSEDED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
  CUSTOM
}

enum RecurringPriceBasis {
  PER_USER_UNIT
  FIXED_TOTAL
}

enum SubscriptionActivationSource {
  MANUAL
  PAYMENT
  TRIAL_CONVERSION
  COMPLIMENTARY
}

enum TrialStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  CONVERTED
}

enum InvoiceNumberResetPolicy {
  NEVER
  CALENDAR_YEAR
  FINANCIAL_YEAR
}

enum RenewalMode {
  MANUAL
  AUTOMATIC
}

enum PaymentProviderType {
  RAZORPAY
}

enum PaymentProviderMode {
  TEST
  LIVE
}

enum PaymentPurpose {
  SUBSCRIPTION_ACTIVATION
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
}

enum PaymentProviderOrderStatus {
  CREATED
  PAID
  CLOSED
}

enum PaymentAttemptOperation {
  ORDER_CREATE
  CHECKOUT_CONFIRMATION
  PROVIDER_PAYMENT
  PROVIDER_FETCH
  CAPTURE
  WEBHOOK
  RECONCILIATION
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum PaymentProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

model Plan {
  id                       String                @id @default(uuid()) @db.Uuid
  code                     String                @unique
  name                     String
  description              String?
  status                   PlanStatus            @default(DRAFT)
  billingModel             PlanBillingModel
  monthlyPricePerSeatMinor Int?
  currency                 String                @default("INR")
  minSeats                 Int?
  maxSeats                 Int?
  sortOrder                Int                   @default(0)
  isPublic                 Boolean               @default(false)
  isRecommended            Boolean               @default(false)
  entitlements             String[]              @default([])
  limits                   Json                  @default("{}")
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  archivedAt               DateTime?
  subscriptions            CompanySubscription[]
  recurringPrices          PlanRecurringPrice[]

  @@index([status, isPublic, sortOrder])
  @@index([billingModel])
  @@index([archivedAt])
}

model PlanRecurringPrice {
  id              String              @id @default(uuid()) @db.Uuid
  planId          String              @db.Uuid
  billingInterval BillingInterval
  basis           RecurringPriceBasis
  amountMinor     BigInt
  currency        String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  plan            Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([planId, billingInterval])
  @@index([billingInterval])
}

model Company {
  id                           String                        @id @default(uuid()) @db.Uuid
  name                         String
  slug                         String
  primaryEmail                 String?
  phone                        String?
  website                      String?
  country                      String?
  timezone                     String                        @default("UTC")
  currency                     String?
  address                      String?
  status                       CompanyStatus                 @default(TRIAL)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  deletedAt                    DateTime?
  branches                     Branch[]
  departments                  Department[]
  designations                 Designation[]
  shifts                       Shift[]
  users                        User[]
  employees                    Employee[]
  shiftAssignments             EmployeeShiftAssignment[]
  shiftRosterPeriods           ShiftRosterPeriod[]
  shiftRosterDays              ShiftRosterDay[]
  rosterTemplates              RosterTemplate[]
  rosterTemplateDays           RosterTemplateDay[]
  rotationPatterns             RotationPattern[]
  rotationPatternDays          RotationPatternDay[]
  weeklyOffRules               WeeklyOffRule[]
  holidayCalendars             HolidayCalendar[]
  holidays                     Holiday[]
  attendances                  Attendance[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  leaveTypes                   LeaveType[]
  leaveRequests                LeaveRequest[]
  leaveBalances                LeaveBalance[]
  leaveApprovalHistories       LeaveApprovalHistory[]
  breakPolicies                BreakPolicy[]
  attendancePolicies           AttendancePolicy[]
  monitoringDevices            MonitoringDevice[]
  heartbeats                   Heartbeat[]
  activitySessions             ActivitySession[]
  screenshots                  Screenshot[]
  applicationUsages            ApplicationUsage[]
  websiteUsages                WebsiteUsage[]
  monitoringAlerts             MonitoringAlert[]
  monitoringAlertEvents        MonitoringAlertEvent[]
  monitoringAlertPolicies      MonitoringAlertPolicy[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  applicationProductivityRules ApplicationProductivityRule[]
  websiteProductivityRules     WebsiteProductivityRule[]
  roles                        Role[]
  auditLogs                    AuditLog[]
  subscriptions                CompanySubscription[]
  trials                       CompanyTrial[]
  payments                     Payment[]

  @@index([status])
  @@index([slug])
  @@index([deletedAt])
}

model CompanySubscription {
  id                        String                       @id @default(uuid()) @db.Uuid
  companyId                 String                       @db.Uuid
  planId                    String                       @db.Uuid
  status                    SubscriptionStatus           @default(PENDING)
  activationSource          SubscriptionActivationSource
  billingInterval           BillingInterval
  planCodeSnapshot          String
  planNameSnapshot          String
  billingModelSnapshot      PlanBillingModel
  currency                  String
  pricePerSeatMinor         Int?
  customRecurringPriceMinor Int?
  recurringPriceBasis       RecurringPriceBasis?
  recurringUnitPriceMinor   BigInt?
  recurringTotalPriceMinor  BigInt?
  recurringCurrency         String?
  pricingInterval           BillingInterval?
  pricingResolvedAt         DateTime?
  seatQuantity              Int
  entitlementsSnapshot      String[]                     @default([])
  limitsSnapshot            Json                         @default("{}")
  startsAt                  DateTime?
  currentPeriodStart        DateTime?
  currentPeriodEnd          DateTime?
  suspendedAt               DateTime?
  cancelledAt               DateTime?
  endedAt                   DateTime?
  supersedesSubscriptionId  String?                      @db.Uuid
  activatedByPaymentId      String?                      @unique @db.Uuid
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  company                   Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan                      Plan                         @relation(fields: [planId], references: [id], onDelete: Restrict)
  supersedes                CompanySubscription?         @relation("SubscriptionLineage", fields: [supersedesSubscriptionId], references: [id], onDelete: Restrict)
  successors                CompanySubscription[]        @relation("SubscriptionLineage")
  convertedTrial            CompanyTrial?
  payments                  Payment[]                    @relation("SubscriptionPayments")
  activatedByPayment        Payment?                     @relation("SubscriptionActivationPayment", fields: [activatedByPaymentId, id, companyId], references: [id, subscriptionId, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@unique([activatedByPaymentId, id, companyId])
  @@index([companyId, status])
  @@index([planId, status])
  @@index([status, currentPeriodEnd])
  @@index([createdAt])
  @@index([supersedesSubscriptionId])
}

model CompanyTrial {
  id                      String               @id @default(uuid()) @db.Uuid
  companyId               String               @db.Uuid
  status                  TrialStatus          @default(ACTIVE)
  startsAt                DateTime             @default(now())
  endsAt                  DateTime
  seatLimit               Int
  entitlementsSnapshot    String[]             @default([])
  limitsSnapshot          Json                 @default("{}")
  cancelledAt             DateTime?
  expiredAt               DateTime?
  convertedAt             DateTime?
  convertedSubscriptionId String?              @unique @db.Uuid
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  convertedSubscription   CompanySubscription? @relation(fields: [convertedSubscriptionId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([status, endsAt])
  @@index([createdAt])
}

model BillingSettings {
  id                       String                   @id @default(uuid()) @db.Uuid
  scope                    String                   @unique @default("PLATFORM")
  invoicePrefix            String                   @default("INV")
  invoiceNumberResetPolicy InvoiceNumberResetPolicy @default(NEVER)
  defaultPaymentTermsDays  Int                      @default(15)
  defaultInvoiceNotes      String?
  sellerLegalName          String?
  sellerBillingEmail       String?
  sellerAddressLine1       String?
  sellerAddressLine2       String?
  sellerCity               String?
  sellerState              String?
  sellerStateCode          String?
  sellerPostalCode         String?
  sellerCountry            String?
  gstEnabled               Boolean                  @default(false)
  gstin                    String?
  gstLegalName             String?
  gstRegisteredState       String?
  gstRegisteredStateCode   String?
  renewalMode              RenewalMode              @default(MANUAL)
  renewalLeadDays          Int                      @default(0)
  renewalGracePeriodDays   Int                      @default(0)
  renewalReminderDays      Int[]                    @default([])
  updatedById              String?                  @db.Uuid
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  updatedBy                User?                    @relation("BillingSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model BillingProviderConfiguration {
  id               String                      @id @default(uuid()) @db.Uuid
  provider         PaymentProviderType
  mode             PaymentProviderMode         @default(TEST)
  displayName      String?
  accountReference String?
  enabled          Boolean                     @default(false)
  isDefault        Boolean                     @default(false)
  updatedById      String?                     @db.Uuid
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  updatedBy        User?                       @relation("BillingProviderConfigurationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  credentials      BillingProviderCredential[]
  payments         Payment[]
  providerOrders   PaymentProviderOrder[]
  providerEvents   PaymentProviderEvent[]

  @@unique([provider, mode])
  @@unique([id, provider, mode])
  @@index([enabled, isDefault])
  @@index([updatedById])
}

model BillingProviderCredential {
  id                      String                       @id @default(uuid()) @db.Uuid
  providerConfigurationId String                       @db.Uuid
  version                 Int
  encryptedPayload        Bytes
  encryptionKeyVersion    String
  credentialFingerprint   String
  activeFrom              DateTime                     @default(now())
  retiredAt               DateTime?
  webhookValidUntil       DateTime?
  createdByUserId         String?                      @db.Uuid
  createdAt               DateTime                     @default(now())
  providerConfiguration   BillingProviderConfiguration @relation(fields: [providerConfigurationId], references: [id], onDelete: Restrict)
  createdBy               User?                        @relation("BillingProviderCredentialCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  verifiedEvents          PaymentProviderEvent[]

  @@unique([providerConfigurationId, version])
  @@unique([id, providerConfigurationId])
  @@index([providerConfigurationId, activeFrom])
  @@index([providerConfigurationId, retiredAt, webhookValidUntil])
  @@index([createdByUserId])
}

model Payment {
  id                        String                       @id @default(uuid()) @db.Uuid
  companyId                 String                       @db.Uuid
  subscriptionId            String                       @db.Uuid
  providerConfigurationId   String                       @db.Uuid
  purpose                   PaymentPurpose
  status                    PaymentStatus                @default(PENDING)
  provider                  PaymentProviderType
  providerMode              PaymentProviderMode
  amountMinor               BigInt
  currency                  String
  idempotencyKey            String
  businessReference         String                       @unique
  capturedProviderPaymentId String?
  providerStatus            String?
  failureCode               String?
  safeFailureMessage        String?
  authorizedAt              DateTime?
  capturedAt                DateTime?
  failedAt                  DateTime?
  createdByUserId           String?                      @db.Uuid
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  company                   Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subscription              CompanySubscription          @relation("SubscriptionPayments", fields: [subscriptionId, companyId], references: [id, companyId], onDelete: Restrict)
  providerConfiguration     BillingProviderConfiguration @relation(fields: [providerConfigurationId, provider, providerMode], references: [id, provider, mode], onDelete: Restrict)
  createdBy                 User?                        @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  orders                    PaymentProviderOrder[]
  attempts                  PaymentAttempt[]
  providerEvents            PaymentProviderEvent[]
  activatedSubscription     CompanySubscription?         @relation("SubscriptionActivationPayment")

  @@unique([companyId, idempotencyKey])
  @@unique([providerConfigurationId, capturedProviderPaymentId])
  @@unique([id, subscriptionId, companyId])
  @@unique([id, providerConfigurationId])
  @@index([companyId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
  @@index([provider, providerMode, status])
  @@index([providerConfigurationId])
  @@index([createdByUserId])
}

model PaymentProviderOrder {
  id                      String                       @id @default(uuid()) @db.Uuid
  paymentId               String                       @db.Uuid
  providerConfigurationId String                       @db.Uuid
  sequence                Int
  status                  PaymentProviderOrderStatus   @default(CREATED)
  providerOrderId         String
  providerStatus          String
  providerReceipt         String
  amountMinor             BigInt
  currency                String
  providerCreatedAt       DateTime?
  usableUntil             DateTime?
  closedAt                DateTime?
  safeMetadata            Json?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  payment                 Payment                      @relation(fields: [paymentId, providerConfigurationId], references: [id, providerConfigurationId], onDelete: Restrict)
  providerConfiguration   BillingProviderConfiguration @relation(fields: [providerConfigurationId], references: [id], onDelete: Restrict)
  attempts                PaymentAttempt[]
  providerEvents          PaymentProviderEvent[]       @relation("EventOrderConfiguration")
  paymentCoherentEvents   PaymentProviderEvent[]       @relation("EventOrderPayment")

  @@unique([paymentId, sequence])
  @@unique([id, paymentId])
  @@unique([id, providerConfigurationId])
  @@unique([providerConfigurationId, providerOrderId])
  @@unique([providerConfigurationId, providerReceipt])
  @@index([paymentId, createdAt])
  @@index([providerConfigurationId, status])
  @@index([status, usableUntil])
}

model PaymentAttempt {
  id                    String                  @id @default(uuid()) @db.Uuid
  paymentId             String                  @db.Uuid
  providerOrderRecordId String?                 @db.Uuid
  sequence              Int
  operation             PaymentAttemptOperation
  status                PaymentAttemptStatus    @default(PENDING)
  providerOrderId       String?
  providerPaymentId     String?
  providerStatus        String?
  amountMinor           BigInt
  currency              String
  requestReference      String
  failureCode           String?
  safeFailureMessage    String?
  safeMetadata          Json?
  startedAt             DateTime                @default(now())
  completedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  payment               Payment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerOrder         PaymentProviderOrder?   @relation(fields: [providerOrderRecordId, paymentId], references: [id, paymentId], onDelete: Restrict)

  @@unique([paymentId, sequence])
  @@unique([paymentId, requestReference])
  @@index([paymentId, createdAt])
  @@index([providerOrderRecordId, createdAt])
  @@index([providerPaymentId])
  @@index([status, createdAt])
}

model PaymentProviderEvent {
  id                       String                       @id @default(uuid()) @db.Uuid
  paymentId                String?                      @db.Uuid
  providerOrderRecordId    String?                      @db.Uuid
  providerConfigurationId  String                       @db.Uuid
  credentialVersionId      String                       @db.Uuid
  provider                 PaymentProviderType
  providerMode             PaymentProviderMode
  providerEventId          String?
  eventType                String
  primaryEntityType        String?
  primaryEntityId          String?
  providerOrderId          String?
  providerPaymentId        String?
  providerRefundId         String?
  providerCreatedAt        DateTime?
  status                   PaymentProviderEventStatus   @default(RECEIVED)
  payloadHash              String
  normalizedPayloadVersion Int                          @default(1)
  normalizedPayload        Json
  signatureVerifiedAt      DateTime
  attemptCount             Int                          @default(0)
  receivedAt               DateTime                     @default(now())
  processingStartedAt      DateTime?
  processedAt              DateTime?
  nextRetryAt              DateTime?
  safeErrorMessage         String?
  payment                  Payment?                     @relation(fields: [paymentId, providerConfigurationId], references: [id, providerConfigurationId], onDelete: Restrict)
  providerOrder            PaymentProviderOrder?        @relation("EventOrderConfiguration", fields: [providerOrderRecordId, providerConfigurationId], references: [id, providerConfigurationId], onDelete: Restrict)
  paymentCoherentOrder     PaymentProviderOrder?        @relation("EventOrderPayment", fields: [providerOrderRecordId, paymentId], references: [id, paymentId], onDelete: Restrict)
  providerConfiguration    BillingProviderConfiguration @relation(fields: [providerConfigurationId, provider, providerMode], references: [id, provider, mode], onDelete: Restrict)
  credentialVersion        BillingProviderCredential    @relation(fields: [credentialVersionId, providerConfigurationId], references: [id, providerConfigurationId], onDelete: Restrict)

  @@index([status, nextRetryAt, receivedAt])
  @@index([paymentId, receivedAt])
  @@index([providerOrderRecordId, receivedAt])
  @@index([provider, providerMode, eventType])
  @@index([providerPaymentId])
  @@index([providerRefundId])
}

model Branch {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  name               String
  code               String
  address            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments        Department[]
  users              User[]
  employees          Employee[]
  shiftRosterPeriods ShiftRosterPeriod[]
  rosterTemplates    RosterTemplate[]
  rotationPatterns   RotationPattern[]
  weeklyOffRules     WeeklyOffRule[]
  holidayCalendars   HolidayCalendar[]

  monitoringAlertPolicies MonitoringAlertPolicy[]

  @@index([companyId])
  @@index([companyId, code])
  @@index([deletedAt])
}

model Department {
  id                 String              @id @default(uuid()) @db.Uuid
  companyId          String              @db.Uuid
  branchId           String?             @db.Uuid
  name               String
  code               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  designations       Designation[]
  users              User[]
  employees          Employee[]
  shiftRosterPeriods ShiftRosterPeriod[]
  rosterTemplates    RosterTemplate[]
  rotationPatterns   RotationPattern[]
  weeklyOffRules     WeeklyOffRule[]

  monitoringAlertPolicies MonitoringAlertPolicy[]

  @@index([companyId])
  @@index([companyId, code])
  @@index([branchId])
  @@index([deletedAt])
}

model Designation {
  id           String      @id @default(uuid()) @db.Uuid
  companyId    String      @db.Uuid
  departmentId String?     @db.Uuid
  name         String
  code         String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users        User[]
  employees    Employee[]

  @@index([companyId])
  @@index([companyId, code])
  @@index([departmentId])
  @@index([deletedAt])
}

model Shift {
  id                  String                    @id @default(uuid()) @db.Uuid
  companyId           String                    @db.Uuid
  name                String
  code                String
  startTime           String
  endTime             String
  timezone            String                    @default("UTC")
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  deletedAt           DateTime?
  company             Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users               User[]
  employees           Employee[]
  shiftAssignments    EmployeeShiftAssignment[]
  attendanceSnapshots Attendance[]              @relation("AttendanceShiftSnapshot")
  rosterDays          ShiftRosterDay[]
  rosterTemplateDays  RosterTemplateDay[]
  rotationPatternDays RotationPatternDay[]

  @@index([companyId])
  @@index([companyId, code])
  @@index([deletedAt])
}

model User {
  id                             String                        @id @default(uuid()) @db.Uuid
  companyId                      String?                       @db.Uuid
  branchId                       String?                       @db.Uuid
  departmentId                   String?                       @db.Uuid
  designationId                  String?                       @db.Uuid
  shiftId                        String?                       @db.Uuid
  email                          String                        @unique
  passwordHash                   String
  firstName                      String
  lastName                       String
  status                         UserStatus                    @default(ACTIVE)
  lastLoginAt                    DateTime?
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  deletedAt                      DateTime?
  company                        Company?                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                         Branch?                       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department                     Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation                    Designation?                  @relation(fields: [designationId], references: [id], onDelete: SetNull)
  shift                          Shift?                        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  roles                          UserRole[]
  refreshTokens                  RefreshToken[]
  auditLogs                      AuditLog[]                    @relation("AuditLogActor")
  createdShiftAssignments        EmployeeShiftAssignment[]     @relation("ShiftAssignmentCreator")
  updatedShiftAssignments        EmployeeShiftAssignment[]     @relation("ShiftAssignmentUpdater")
  publishedShiftRosterPeriods    ShiftRosterPeriod[]           @relation("ShiftRosterPublishedBy")
  lockedShiftRosterPeriods       ShiftRosterPeriod[]           @relation("ShiftRosterLockedBy")
