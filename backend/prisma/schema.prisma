model Role {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String?          @db.Uuid
  key         String
  name        String
  systemName  RoleName?
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@index([companyId])
  @@index([companyId, key])
  @@index([systemName])
  @@index([deletedAt])
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MonitoringAlertPolicy {
  id                String                     @id @default(uuid()) @db.Uuid
  companyId         String?                    @db.Uuid
  branchId          String?                    @db.Uuid
  departmentId      String?                    @db.Uuid
  employeeId        String?                    @db.Uuid
  name              String
  description       String?
  enabled           Boolean                    @default(true)
  priority          Int                        @default(100)
  scope             MonitoringAlertPolicyScope
  settings          Json
  maintenanceStart  DateTime?
  maintenanceEnd    DateTime?
  maintenanceReason String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  deletedAt         DateTime?
  company           Company?                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch            Branch?                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department        Department?                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employee          Employee?                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([scope, enabled])
  @@index([companyId, scope, priority])
  @@index([branchId, priority])
  @@index([departmentId, priority])
  @@index([employeeId, priority])
  @@index([deletedAt])
}

model MonitoringAlert {
  id                   String                  @id @default(uuid()) @db.Uuid
  companyId            String                  @db.Uuid
  employeeId           String?                 @db.Uuid
  deviceId             String?                 @db.Uuid
  type                 MonitoringAlertType
  severity             MonitoringAlertSeverity
  status               MonitoringAlertStatus   @default(OPEN)
  title                String
  message              String
  deduplicationKey     String
  detectedAt           DateTime
  lastDetectedAt       DateTime
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?                 @db.Uuid
  resolvedAt           DateTime?
  resolvedByUserId     String?                 @db.Uuid
  resolutionNote       String?
  metadata             Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee             Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  device               MonitoringDevice?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  acknowledgedBy       User?                   @relation("MonitoringAlertAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  resolvedBy           User?                   @relation("MonitoringAlertResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  events               MonitoringAlertEvent[]
  notifications        Notification[]

  @@index([companyId, status])
  @@index([companyId, type, status])
  @@index([employeeId, status])
  @@index([deviceId, status])
  @@index([deduplicationKey])
  @@index([detectedAt])
  @@index([lastDetectedAt])
}

model MonitoringAlertEvent {
  id          String                   @id @default(uuid()) @db.Uuid
  alertId     String                   @db.Uuid
  companyId   String                   @db.Uuid
  type        MonitoringAlertEventType
  actorUserId String?                  @db.Uuid
  occurredAt  DateTime                 @default(now())
  note        String?
  metadata    Json?
  alert       MonitoringAlert          @relation(fields: [alertId], references: [id], onDelete: Cascade)
  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor       User?                    @relation("MonitoringAlertEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([alertId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([type])
}

model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String?  @db.Uuid
  userId          String   @unique @db.Uuid
  inAppEnabled    Boolean  @default(true)
  emailEnabled    Boolean  @default(true)
  criticalAlerts  Boolean  @default(true)
  warningAlerts   Boolean  @default(true)
  infoAlerts      Boolean  @default(true)
  alertOpened     Boolean  @default(true)
  alertResolved   Boolean  @default(false)
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
}

model Notification {
  id             String                   @id @default(uuid()) @db.Uuid
  companyId      String?                  @db.Uuid
  userId         String                   @db.Uuid
  alertId        String?                  @db.Uuid
  type           NotificationType
  channel        NotificationChannel
  title          String
  message        String
  severity       MonitoringAlertSeverity?
  status         NotificationStatus       @default(PENDING)
  readAt         DateTime?
  detailsPath    String?
  idempotencyKey String                   @unique
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  company        Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert          MonitoringAlert?         @relation(fields: [alertId], references: [id], onDelete: SetNull)
  deliveries     NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@index([companyId, createdAt])
  @@index([alertId])
  @@index([channel, status])
}

model NotificationDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  notificationId    String              @db.Uuid
  channel           NotificationChannel
  recipient         String
  status            NotificationStatus  @default(PENDING)
  attemptCount      Int                 @default(0)
  lastAttemptAt     DateTime?
  nextRetryAt       DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  errorCode         String?
  safeErrorMessage  String?
  providerMessageId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  notification      Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextRetryAt])
  @@index([channel, status])
  @@index([recipient])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
