  actor          User                @relation("LeaveApprovalHistoryActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([leaveRequestId, createdAt])
  @@index([actorUserId, createdAt])
}

model LeaveBalance {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  employeeId  String    @db.Uuid
  leaveTypeId String    @db.Uuid
  year        Int
  allocated   Float     @default(0)
  used        Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([companyId, year])
}

model AttendancePolicy {
  id                              String   @id @default(uuid()) @db.Uuid
  companyId                       String   @db.Uuid
  autoPunchOutOnHeartbeatLoss     Boolean  @default(true)
  heartbeatTimeoutMinutes         Int      @default(30)
  attendanceDayStartTime          String   @default("00:00")
  allowMultiplePunchSessions      Boolean  @default(true)
  autoClosePreviousDayOpenSession Boolean  @default(true)
  autoCloseEnabled                Boolean  @default(true)
  disconnectGraceMinutes          Int      @default(30)
  postShiftGraceMinutes           Int      @default(60)
  maximumOpenSessionMinutes       Int      @default(960)
  noHeartbeatFallbackMinutes      Int      @default(720)
  isActive                        Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  company                         Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, isActive])
}

model MonitoringDevice {
  id                       String                 @id @default(uuid()) @db.Uuid
  companyId                String                 @db.Uuid
  employeeId               String                 @db.Uuid
  deviceIdentifier         String
  deviceName               String
  platform                 String
  osVersion                String?
  appVersion               String?
  status                   MonitoringDeviceStatus @default(ACTIVE)
  trustedAt                DateTime?
  revokedAt                DateTime?
  registrationResetAt      DateTime?
  reregistrationRequiredAt DateTime?
  registrationVersion      Int                    @default(1)
  lastSeenAt               DateTime?
  registeredAt             DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?
  company                  Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee                 Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  heartbeats               Heartbeat[]
  activitySessions         ActivitySession[]
  screenshots              Screenshot[]
  applicationUsages        ApplicationUsage[]
  websiteUsages            WebsiteUsage[]

  monitoringAlerts MonitoringAlert[]

  @@unique([employeeId, deviceIdentifier])
  @@index([companyId, status])
  @@index([employeeId, status])
  @@index([lastSeenAt])
  @@index([deletedAt])
}

model Heartbeat {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  employeeId  String           @db.Uuid
  deviceId    String           @db.Uuid
  recordedAt  DateTime         @default(now())
  idleSeconds Int              @default(0)
  isOnline    Boolean          @default(true)
  metadata    Json?
  createdAt   DateTime         @default(now())
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device      MonitoringDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([companyId, recordedAt])
  @@index([employeeId, recordedAt])
  @@index([deviceId, recordedAt])
}

model ActivitySession {
  id                String             @id @default(uuid()) @db.Uuid
  companyId         String             @db.Uuid
  employeeId        String             @db.Uuid
  deviceId          String             @db.Uuid
  clientSessionId   String
  startedAt         DateTime
  endedAt           DateTime
  activeSeconds     Int                @default(0)
  idleSeconds       Int                @default(0)
  keyboardCount     Int                @default(0)
  keystrokeCount    Int?
  mouseClickCount   Int                @default(0)
  mouseMoveCount    Int                @default(0)
  scrollCount       Int                @default(0)
  metadata          Json?
  createdAt         DateTime           @default(now())
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device            MonitoringDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  applicationUsages ApplicationUsage[]
  websiteUsages     WebsiteUsage[]

  @@unique([deviceId, clientSessionId])
  @@index([companyId, startedAt])
  @@index([employeeId, startedAt])
  @@index([deviceId, startedAt])
}

model Screenshot {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @db.Uuid
  employeeId         String           @db.Uuid
